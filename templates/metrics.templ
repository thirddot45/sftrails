package templates

import (
	"strconv"

	"sftrails/models"
)

// metricsRobots is the robots policy for the dashboard. It must match the
// X-Robots-Tag that handlers.MetricsDiscoveryMiddleware sets on the response;
// a test compares the two so the tag and the header cannot drift apart.
const metricsRobots = "noindex, nofollow, nosnippet, noarchive"

// MetricsPage renders the traffic dashboard as bare name/value data points.
//
// It deliberately does not use LayoutDocument: no Tailwind, no HTMX, no
// vendored scripts, no header, footer, branding, or navigation. The page is a
// human-readable list of aggregate counts and nothing else, which keeps the
// surface a crawler could index down to the numbers themselves. All counts are
// aggregates — no visitor identifiers, IP addresses, or user agents appear.
templ MetricsPage(m models.SiteMetrics) {
	<!DOCTYPE html>
	<html lang="en">
	<head>
		<meta charset="UTF-8"/>
		<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
		<title>SF Trails Metrics</title>
		<meta name="robots" content={ metricsRobots }/>
	</head>
	<body>
		<h1>SF Trails Metrics</h1>
		<p>Aggregate traffic counts, refreshed once a minute. Individual visitor records and IP addresses are not shown.</p>
		<h2>Totals</h2>
		<ul>
			@dataPoint("Total visits", m.TotalViews)
			@dataPoint("Unique visitors", m.UniqueVisits)
			@dataPoint("Visits today", m.ViewsToday)
			@dataPoint("Unique today", m.UniqueToday)
		</ul>
		<h2>Last 7 days</h2>
		<ul>
			for _, d := range m.Days {
				<li>{ d.Date }: { strconv.Itoa(d.Views) } visits, { strconv.Itoa(d.Unique) } unique</li>
			}
		</ul>
		<h2>Top pages</h2>
		if len(m.TopPaths) == 0 {
			<ul><li>No page views recorded.</li></ul>
		} else {
			<ul>
				for _, p := range m.TopPaths {
					@dataPoint(p.Path, p.Views)
				}
			</ul>
		}
	</body>
	</html>
}

// dataPoint renders a single labelled count as a list item.
templ dataPoint(label string, value int) {
	<li>{ label }: { strconv.Itoa(value) }</li>
}
