package templates

import (
	"strconv"

	"sftrails/models"
)

// NoIndexDirectives is the robots policy for pages that must stay out of search
// indexes and AI training/inference corpora. The standard tokens
// (noindex/nofollow/noarchive/nosnippet/noimageindex) cover search engines;
// noai/noimageai are the de-facto opt-out signals honored by AI crawlers. It is
// emitted both as a <meta name="robots"> tag here and as an X-Robots-Tag
// response header by the handlers package.
const NoIndexDirectives = "noindex, nofollow, noarchive, nosnippet, noimageindex, noai, noimageai"

// MetricsPage renders the traffic dashboard as bare name/value data points.
//
// It deliberately does not use the site Layout: no Tailwind, no HTMX, no
// fingerprint/sort scripts, no header, footer, branding, or navigation. The
// page is a human-readable list of aggregate counts and nothing else, which
// keeps the surface that a crawler could index down to the numbers themselves.
// All counts are aggregates — no IP addresses or personal data are included.
templ MetricsPage(m models.SiteMetrics) {
	<!DOCTYPE html>
	<html lang="en">
	<head>
		<meta charset="UTF-8"/>
		<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
		<title>SF Trails Metrics</title>
		<meta name="robots" content={ NoIndexDirectives }/>
	</head>
	<body>
		<h1>SF Trails Metrics</h1>
		<h2>Totals</h2>
		<ul>
			@dataPoint("Total visits", m.TotalViews)
			@dataPoint("Unique visitors", m.UniqueVisits)
			@dataPoint("Visits today", m.ViewsToday)
			@dataPoint("Unique today", m.UniqueToday)
		</ul>
		<h2>Last 7 days</h2>
		<ul>
			for _, d := range m.Days {
				<li>{ d.Date }: { strconv.Itoa(d.Views) } visits, { strconv.Itoa(d.Unique) } unique</li>
			}
		</ul>
		<h2>Top pages</h2>
		if len(m.TopPaths) == 0 {
			<ul><li>No page views recorded.</li></ul>
		} else {
			<ul>
				for _, p := range m.TopPaths {
					@dataPoint(p.Path, p.Views)
				}
			</ul>
		}
	</body>
	</html>
}

// dataPoint renders a single labelled count as a list item.
templ dataPoint(label string, value int) {
	<li>{ label }: { strconv.Itoa(value) }</li>
}
