package templates

templ Layout(title string, description string) {
	<!DOCTYPE html>
	<html lang="en">
	<head>
		<meta charset="UTF-8"/>
		<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
		<title>{ title }</title>
		<meta name="description" content={ description }/>
		<link rel="canonical" href="https://sftrails.info/"/>
		<!-- Open Graph -->
		<meta property="og:type" content="website"/>
		<meta property="og:title" content={ title }/>
		<meta property="og:description" content={ description }/>
		<meta property="og:url" content="https://sftrails.info/"/>
		<meta property="og:site_name" content="SF Trails"/>
		<meta property="og:locale" content="en_US"/>
		<!-- Twitter Card -->
		<meta name="twitter:card" content="summary"/>
		<meta name="twitter:title" content={ title }/>
		<meta name="twitter:description" content={ description }/>
		<meta name="theme-color" content="#064e3b"/>
		<script type="application/ld+json">
		{
			"@context": "https://schema.org",
			"@type": "WebApplication",
			"name": "SF Trails",
			"description": "Community-driven South Florida mountain bike trail status tracker. Real-time trail conditions reported by riders.",
			"url": "https://sftrails.info",
			"applicationCategory": "SportsApplication",
			"operatingSystem": "Web",
			"offers": {
				"@type": "Offer",
				"price": "0",
				"priceCurrency": "USD"
			},
			"author": {
				"@type": "Organization",
				"name": "SF Trails"
			},
			"areaServed": {
				"@type": "State",
				"name": "Florida",
				"containedInPlace": {
					"@type": "Country",
					"name": "United States"
				}
			}
		}
		</script>
		<script src="https://unpkg.com/htmx.org@2.0.4/dist/htmx.min.js" defer></script>
		<script src="https://cdn.tailwindcss.com"></script>
		<script>
			tailwind.config = {
				theme: {
					extend: {
						colors: {
							dark: {
								900: '#0a0f1a',
								800: '#111827',
								700: '#1a2332',
								600: '#1f2937',
							}
						},
						animation: {
							'pulse-slow': 'pulse 3s cubic-bezier(0.4, 0, 0.6, 1) infinite',
							'fade-in': 'fadeIn 0.5s ease-out forwards',
							'slide-up': 'slideUp 0.4s ease-out forwards',
						},
						keyframes: {
							fadeIn: {
								'0%': { opacity: '0' },
								'100%': { opacity: '1' },
							},
							slideUp: {
								'0%': { opacity: '0', transform: 'translateY(12px)' },
								'100%': { opacity: '1', transform: 'translateY(0)' },
							},
						}
					}
				}
			}
		</script>
		<script src="/static/fingerprint.js" defer></script>
		<style>
			body {
				background-color: #0a0f1a;
				background-image:
					radial-gradient(ellipse at 20% 0%, rgba(16, 185, 129, 0.08) 0%, transparent 60%),
					radial-gradient(ellipse at 80% 100%, rgba(6, 78, 59, 0.06) 0%, transparent 60%);
				background-attachment: fixed;
			}
			.trail-card {
				transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
				border: 1px solid rgba(255, 255, 255, 0.06);
				background: rgba(17, 24, 39, 0.7);
				backdrop-filter: blur(12px);
				-webkit-backdrop-filter: blur(12px);
			}
			@media (hover: hover) {
				.trail-card:hover {
					transform: translateY(-2px);
					box-shadow: 0 8px 25px rgba(0, 0, 0, 0.4), 0 0 0 1px rgba(16, 185, 129, 0.1);
					border-color: rgba(16, 185, 129, 0.15);
				}
			}
			button { -webkit-tap-highlight-color: transparent; touch-action: manipulation; }

			.status-bar-track {
				height: 0.5rem;
				border-radius: 9999px;
				width: 100%;
				background-color: rgba(31, 41, 55, 0.8);
				overflow: hidden;
				border: 1px solid rgba(255, 255, 255, 0.05);
			}
			.status-bar-fill {
				height: 100%;
				border-radius: 9999px;
				transition: width 0.6s cubic-bezier(0.4, 0, 0.2, 1), background-color 0.5s ease;
			}
			.fill-open { background: linear-gradient(90deg, #10b981, #34d399); }
			.fill-closed { background: linear-gradient(90deg, #ef4444, #f87171); }
			.fill-mixed { background: linear-gradient(90deg, #f59e0b, #fbbf24); }

			.vote-btn {
				transition: all 0.15s ease;
				position: relative;
				overflow: hidden;
			}
			.vote-btn::after {
				content: '';
				position: absolute;
				inset: 0;
				background: rgba(255,255,255,0);
				transition: background 0.15s ease;
			}
			.vote-btn:active::after {
				background: rgba(255,255,255,0.1);
			}

			@keyframes stagger {
				0% { opacity: 0; transform: translateY(12px); }
				100% { opacity: 1; transform: translateY(0); }
			}
			.trail-card { animation: stagger 0.4s ease-out backwards; }
			.trail-card:nth-child(1) { animation-delay: 0.05s; }
			.trail-card:nth-child(2) { animation-delay: 0.1s; }
			.trail-card:nth-child(3) { animation-delay: 0.15s; }
			.trail-card:nth-child(4) { animation-delay: 0.2s; }
			.trail-card:nth-child(5) { animation-delay: 0.25s; }
			.trail-card:nth-child(6) { animation-delay: 0.3s; }
			.trail-card:nth-child(7) { animation-delay: 0.35s; }
			.trail-card:nth-child(8) { animation-delay: 0.4s; }
			.trail-card:nth-child(9) { animation-delay: 0.45s; }
			.trail-card:nth-child(10) { animation-delay: 0.5s; }
			.trail-card:nth-child(11) { animation-delay: 0.55s; }
			.trail-card:nth-child(12) { animation-delay: 0.6s; }

			.search-input {
				transition: all 0.2s ease;
				background: rgba(17, 24, 39, 0.6);
				backdrop-filter: blur(8px);
			}
			.search-input:focus {
				box-shadow: 0 0 0 2px rgba(16, 185, 129, 0.3);
				border-color: rgba(16, 185, 129, 0.5);
			}

			.filter-chip {
				transition: all 0.15s ease;
			}
			.filter-chip.active {
				background: rgba(16, 185, 129, 0.2);
				border-color: rgba(16, 185, 129, 0.4);
				color: #34d399;
			}
		</style>
	</head>
	<body class="min-h-screen text-gray-100">
		<!-- Header -->
		<header class="relative overflow-hidden border-b border-white/5">
			<div class="absolute inset-0 bg-gradient-to-br from-emerald-900/40 via-dark-800 to-dark-900"></div>
			<div class="absolute inset-0 bg-[url('data:image/svg+xml;base64,')] opacity-30"></div>
			<div class="relative max-w-5xl mx-auto px-4 py-8 sm:py-10">
				<div class="flex items-center gap-3 mb-2">
					<div class="flex items-center justify-center w-10 h-10 rounded-xl bg-emerald-500/20 border border-emerald-500/30">
						<span class="text-xl">🚴</span>
					</div>
					<h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-white">SF Trails</h1>
				</div>
				<p class="text-emerald-300/70 text-base sm:text-lg mt-1 ml-[52px]">South Florida Mountain Bike Trail Status</p>
				<div class="flex items-center gap-2 mt-3 ml-[52px]">
					<span class="relative flex h-2.5 w-2.5">
						<span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
						<span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-emerald-500"></span>
					</span>
					<span class="text-xs text-emerald-400/60 uppercase tracking-wider font-medium">Live Updates</span>
				</div>
			</div>
		</header>

		<!-- Main Content -->
		<main class="max-w-5xl mx-auto px-4 py-6 sm:py-8">
			{ children... }
		</main>

		<!-- Footer -->
		<footer class="border-t border-white/5 mt-16">
			<div class="max-w-5xl mx-auto px-4 py-8">
				<div class="flex flex-col sm:flex-row items-center justify-between gap-4">
					<div class="flex items-center gap-2 text-gray-500 text-sm">
						<span>🚴</span>
						<span>Community-driven trail status reports</span>
					</div>
					<div class="flex items-center gap-4 text-xs text-gray-600">
						<a href="/api/trails" class="hover:text-emerald-400 transition-colors">API</a>
						<span class="text-gray-700">|</span>
						<span>Vote to help fellow riders!</span>
					</div>
				</div>
			</div>
		</footer>

		<!-- Client-side search/filter script -->
		<script>
			document.addEventListener('DOMContentLoaded', function() {
				function setupFilters() {
					const searchInput = document.getElementById('trail-search');
					const filterChips = document.querySelectorAll('.filter-chip');
					if (!searchInput) return;

					let activeFilter = 'all';

					function filterTrails() {
						const query = searchInput.value.toLowerCase().trim();
						const cards = document.querySelectorAll('.trail-card');
						cards.forEach(function(card) {
							const name = (card.getAttribute('data-name') || '').toLowerCase();
							const city = (card.getAttribute('data-city') || '').toLowerCase();
							const status = card.getAttribute('data-status') || '';
							const matchesSearch = !query || name.includes(query) || city.includes(query);
							const matchesFilter = activeFilter === 'all' || status === activeFilter;
							card.style.display = (matchesSearch && matchesFilter) ? '' : 'none';
						});
					}

					searchInput.addEventListener('input', filterTrails);

					filterChips.forEach(function(chip) {
						chip.addEventListener('click', function() {
							activeFilter = chip.getAttribute('data-filter');
							filterChips.forEach(function(c) { c.classList.remove('active'); });
							chip.classList.add('active');
							filterTrails();
						});
					});
				}

				setupFilters();
				// Re-setup after HTMX swaps
				document.body.addEventListener('htmx:afterSwap', setupFilters);
			});
		</script>
	</body>
	</html>
}
