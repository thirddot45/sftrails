package templates

import (
	"sftrails/models"
	"fmt"
	"strings"
)

func trailsJSONLD(trails []models.TrailWithStatus) string {
	var items []string
	for _, t := range trails {
		status := "Unknown"
		if t.Status == models.StatusOpen {
			status = "Open"
		} else if t.Status == models.StatusClosed {
			status = "Closed"
		}
		item := fmt.Sprintf(`{
			"@type": "SportsActivityLocation",
			"name": %q,
			"description": %q,
			"address": {
				"@type": "PostalAddress",
				"addressLocality": %q,
				"addressRegion": "FL",
				"addressCountry": "US"
			},
			"geo": {
				"@type": "GeoCoordinates",
				"latitude": %f,
				"longitude": %f
			},
			"publicAccess": true,
			"additionalProperty": {
				"@type": "PropertyValue",
				"name": "Trail Status",
				"value": %q
			}
		}`, t.Name, t.Description, t.City, t.Latitude, t.Longitude, status)
		items = append(items, item)
	}
	return fmt.Sprintf(`{
		"@context": "https://schema.org",
		"@type": "WebSite",
		"name": "SF Trails",
		"url": "https://sftrails.info",
		"description": "Community-driven South Florida mountain bike trail status reports",
		"hasPart": [%s]
	}`, strings.Join(items, ","))
}

func trailsJSONLDScript(trails []models.TrailWithStatus) string {
	return `<script type="application/ld+json">` + trailsJSONLD(trails) + `</script>`
}

templ IndexPage(trails []models.TrailWithStatus) {
	@Layout("SF Trails - South Florida Mountain Bike Trail Status", "Check real-time trail conditions for South Florida mountain bike trails. Community-driven status reports for Markham Park, Oleta River, Virginia Key, and more.") {
		@templ.Raw(trailsJSONLDScript(trails))

		<!-- Search & Filter Bar -->
		<div class="mb-6 space-y-3">
			<div class="relative">
				<div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none">
					<svg class="w-4 h-4 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
					</svg>
				</div>
				<input
					id="trail-search"
					type="text"
					placeholder="Search trails by name or city..."
					class="search-input w-full pl-10 pr-4 py-2.5 rounded-xl border border-white/10 text-sm text-white placeholder-gray-500 focus:outline-none"
				/>
			</div>
			<div class="flex items-center gap-2 flex-wrap">
				<button data-filter="all" class="filter-chip active px-3 py-1.5 rounded-lg border border-white/10 text-xs font-medium text-gray-400">All</button>
				<button data-filter="open" class="filter-chip px-3 py-1.5 rounded-lg border border-white/10 text-xs font-medium text-gray-400">
					<span class="inline-block w-1.5 h-1.5 rounded-full bg-emerald-500 mr-1.5"></span>Open
				</button>
				<button data-filter="closed" class="filter-chip px-3 py-1.5 rounded-lg border border-white/10 text-xs font-medium text-gray-400">
					<span class="inline-block w-1.5 h-1.5 rounded-full bg-red-500 mr-1.5"></span>Closed
				</button>
				<button data-filter="unknown" class="filter-chip px-3 py-1.5 rounded-lg border border-white/10 text-xs font-medium text-gray-400">
					<span class="inline-block w-1.5 h-1.5 rounded-full bg-gray-500 mr-1.5"></span>No Reports
				</button>
			</div>
		</div>

		<!-- Instructions -->
		<section aria-label="Trail status instructions" class="mb-6">
			<div class="flex items-center gap-2 px-4 py-3 rounded-xl bg-emerald-500/5 border border-emerald-500/10">
				<svg class="w-4 h-4 text-emerald-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
				</svg>
				<p class="text-sm text-emerald-300/80">Tap <strong class="text-emerald-300">Rideable</strong> or <strong class="text-emerald-300">Closed</strong> to report conditions. Status updates every 60s.</p>
			</div>
		</section>

		<!-- Trail Listings -->
		<section aria-label="Trail listings">
			@TrailsList(trails)
		</section>
	}
}

templ TrailsList(trails []models.TrailWithStatus) {
	<div id="trails-list" class="grid grid-cols-1 md:grid-cols-2 gap-4" hx-get="/trails-list" hx-trigger="every 60s" hx-swap="outerHTML">
		for _, trail := range trails {
			@TrailCard(trail)
		}
	</div>
}
