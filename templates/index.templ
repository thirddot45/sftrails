package templates

import "sftrails/models"

templ IndexPage(trails []models.TrailWithStatus, sortLabel string) {
	@Layout("SF Trails - South Florida Mountain Bike Trail Status", "Check real-time trail conditions for South Florida mountain bike trails. Community-driven status reports for Markham Park, Oleta River, Virginia Key, and more.") {
		@templ.Raw(trailsJSONLDScript(trails))
		<section aria-label="Trail status instructions" class="mb-6">
			<p class="text-gray-300">Click <strong>Rideable</strong> or <strong>Closed</strong> to report current trail conditions. Status updates every 60 seconds.</p>
		</section>
		<section aria-label="Trail sort controls">
			@SortControls(sortLabel)
		</section>
		<section aria-label="Trail listings">
			@TrailsList(trails)
		</section>
	}
}

templ TrailsList(trails []models.TrailWithStatus) {
	<div id="trails-list" hx-get="/trails-list" hx-trigger="every 60s" hx-swap="outerHTML">
		for _, trail := range trails {
			@TrailCard(trail)
		}
	</div>
}
