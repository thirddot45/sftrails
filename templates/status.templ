package templates

import (
	"fmt"
	"time"

	"sftrails/weather"
)

type StatusData struct {
	Endpoints        []weather.EndpointCheck
	WeatherCached    int
	WeatherTotal     int
	WeatherRefresh   time.Time
	WeatherHasData   bool
}

func formatLatency(d time.Duration) string {
	if d < time.Millisecond {
		return fmt.Sprintf("%dµs", d.Microseconds())
	}
	return fmt.Sprintf("%dms", d.Milliseconds())
}

func formatRefresh(t time.Time) string {
	if t.IsZero() {
		return "never"
	}
	return t.UTC().Format("2006-01-02 15:04:05 UTC")
}

templ StatusPage(data StatusData) {
	@Layout("SF Trails - Status", "System status and outbound endpoint health for SF Trails.") {
		<section aria-label="Status overview" class="mb-6">
			<h2 class="text-xl font-bold text-white mb-2">System Status</h2>
			<p class="text-gray-400 text-sm">Quick health check of outbound endpoints and internal caches.</p>
		</section>

		<section aria-label="Outbound endpoints" class="mb-6">
			<h3 class="text-lg font-semibold text-white mb-3">Outbound Endpoints</h3>
			<div class="space-y-2">
				for _, ep := range data.Endpoints {
					<div class="bg-gray-800 rounded-xl p-4 shadow">
						<div class="flex items-center justify-between">
							<div class="flex items-center gap-2 min-w-0 flex-1">
								if ep.OK {
									<span class="text-green-400" aria-label="healthy">●</span>
								} else {
									<span class="text-red-400" aria-label="failing">●</span>
								}
								<span class="text-white font-semibold truncate">{ ep.Name }</span>
							</div>
							<div class="flex items-center gap-3 flex-shrink-0 ml-3">
								if ep.OK {
									<span class="px-2 py-0.5 rounded-full text-xs font-semibold bg-green-500 text-white">OK</span>
								} else {
									<span class="px-2 py-0.5 rounded-full text-xs font-semibold bg-red-500 text-white">FAIL</span>
								}
								<span class="text-gray-400 text-sm">{ formatLatency(ep.Latency) }</span>
							</div>
						</div>
						<details class="mt-3">
							<summary class="cursor-pointer text-sm text-gray-400 hover:text-white select-none">Details</summary>
							<div class="mt-2 space-y-1 text-sm">
								<div class="flex gap-2">
									<span class="text-gray-500 w-20 flex-shrink-0">URL:</span>
									<span class="text-gray-300 break-all">{ ep.URL }</span>
								</div>
								<div class="flex gap-2">
									<span class="text-gray-500 w-20 flex-shrink-0">Status:</span>
									if ep.Status > 0 {
										<span class="text-gray-300">{ fmt.Sprintf("HTTP %d", ep.Status) }</span>
									} else {
										<span class="text-gray-300">—</span>
									}
								</div>
								<div class="flex gap-2">
									<span class="text-gray-500 w-20 flex-shrink-0">Latency:</span>
									<span class="text-gray-300">{ formatLatency(ep.Latency) }</span>
								</div>
								if ep.Error != "" {
									<div class="flex gap-2">
										<span class="text-gray-500 w-20 flex-shrink-0">Error:</span>
										<span class="text-red-400 break-all">{ ep.Error }</span>
									</div>
								}
							</div>
						</details>
					</div>
				}
			</div>
		</section>

		<section aria-label="Weather cache" class="mb-6">
			<h3 class="text-lg font-semibold text-white mb-3">Weather Cache</h3>
			<div class="bg-gray-800 rounded-xl p-4 shadow">
				<div class="grid grid-cols-2 gap-2 text-sm">
					<div class="text-gray-500">Last refreshed</div>
					<div class="text-gray-300">{ formatRefresh(data.WeatherRefresh) }</div>
					<div class="text-gray-500">Forecasts cached</div>
					<div class="text-gray-300">{ fmt.Sprintf("%d / %d trails", data.WeatherCached, data.WeatherTotal) }</div>
				</div>
			</div>
		</section>

		<section class="text-center">
			<a href="/" class="text-gray-400 hover:text-white text-sm">← Back to trails</a>
		</section>
	}
}
